// Movie Ticket Booking (Age-Based Pricing)
#include <iostream>

int main() {
    int age;
    int numTickets;
    double basePrice = 12.00; // Standard price of a ticket in dollars
    double finalCost = 0.0;

    std::cout << "--- Cinema Ticket Counter ---" << std::endl;
    std::cout << "Enter the age of the viewer: ";
    std::cin >> age;

    std::cout << "How many tickets do you want to buy? ";
    std::cin >> numTickets;

    // Determine price based on age rules
    if (age < 5) {
        // Toddlers go free
        finalCost = 0.0;
        std::cout << "Tickets are free for children under 5!" << std::endl;
    } else if (age <= 12 || age >= 60) {
        // 50% discount for kids (5-12) and seniors (60+)
        finalCost = (basePrice * 0.50) * numTickets;
        std::cout << "50% Discount Applied (Child/Senior rate)." << std::endl;
    } else {
        // Regular price for everyone else
        finalCost = basePrice * numTickets;
        std::cout << "Standard Adult rate applied." << std::endl;
    }

    std::cout << "Total Amount to Pay: $" << finalCost << std::endl;
    return 0;
}
